{
  "name": "tv-digital",
  "private": true,
  "version": "0.1.0",
  "description": "Web GIS cek sinyal TV digital (DVB-T2) Indonesia berdasarkan lokasi rumah dan tinggi antena",
  "license": "MIT",
  "repository": "github:habib-roy/indonesian-digital-tv-coverage",
  "homepage": "https://github.com/habib-roy/indonesian-digital-tv-coverage",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "node --test 'test/*.test.ts'",
    "validate-data": "node scripts/validate-data.ts",
    "check": "prettier --check . && pnpm lint && pnpm typecheck && pnpm test && pnpm validate-data"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
